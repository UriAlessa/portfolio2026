---
import '../styles/globals.css'; 
import { personalInfo, habilidades, educacion, proyectos, experiencia, seo } from '../data/portfolio';
import { AnimateOnScroll } from '../components/AnimateOnScroll';
import { ProjectCard } from '../components/ProjectCard';
import { Badge } from "@/components/ui/badge";
import { Separator } from "@/components/ui/separator";
import { ThemeToggle } from '@/components/ThemeToggle';
import { ContactForm } from '../components/ContactForm';
import { AvatarSection } from '../components/AvatarSection';
import { SocialLinks } from '../components/SocialLinks';
import { MobileMenu } from '../components/MobileMenu';
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- SEO Básico -->
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <meta name="author" content={personalInfo.nombre} />
  <link rel="canonical" href={seo.url} />

  <!-- Open Graph (Facebook, LinkedIn, WhatsApp, Discord) -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={seo.url} />
  <meta property="og:title" content={seo.title} />
  <meta property="og:description" content={seo.description} />
  <meta property="og:image" content={`${seo.url}${seo.image}`} />
  <meta property="og:locale" content="es_AR" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={seo.url} />
  <meta name="twitter:title" content={seo.title} />
  <meta name="twitter:description" content={seo.description} />
  <meta name="twitter:image" content={`${seo.url}${seo.image}`} />

  <link rel="icon" type="image/svg+xml" href={seo.image} />
</head>
<body class="bg-background text-foreground antialiased">
  
  <!-- Navegación -->
  <nav class="fixed top-0 w-full bg-background/80 backdrop-blur-md z-50 border-b">
    <div class="container mx-auto px-4 py-4 flex justify-between items-center max-w-4xl">
      <span class="font-bold text-xl">{personalInfo.nombre}</span>
      <div class="flex items-center gap-4">
        <!-- Links de desktop -->
        <div class="hidden md:flex gap-6 text-sm font-medium">
          <a href="#sobre-mi" class="hover:text-primary transition-colors">Sobre mí</a>
          <a href="#experiencia" class="hover:text-primary transition-colors">Experiencia</a>
          <a href="#educacion" class="hover:text-primary transition-colors">Educación</a>
          <a href="#proyectos" class="hover:text-primary transition-colors">Proyectos</a>
          <a href="#contacto" class="hover:text-primary transition-colors">Contacto</a>
        </div>
        
        <!-- Botón de tema -->
        <ThemeToggle client:load />
        
        <!-- Botón hamburguesa (solo el botón, no el drawer) -->
        <button
          id="mobile-menu-button"
          class="md:hidden inline-flex items-center justify-center h-10 w-10 rounded-md border border-input bg-background hover:bg-accent hover:text-accent-foreground transition-all"
          aria-label="Abrir menú"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Menú móvil (FUERA del navbar, como hermano) -->
  <MobileMenu 
    client:load
    links={[
      { href: '#sobre-mi', label: 'Sobre mí' },
      { href: '#experiencia', label: 'Experiencia' },
      { href: '#educacion', label: 'Educación' },
      { href: '#proyectos', label: 'Proyectos' },
      { href: '#contacto', label: 'Contacto' }
    ]}
  />

   <main class="container mx-auto px-4 max-w-4xl pt-24 pb-16 space-y-24">
    
    <!-- Sección: Sobre Mí -->
        <!-- Sección: Sobre Mí -->
    <AnimateOnScroll client:visible animation="fade-up">
      <section id="sobre-mi" class="space-y-6">
        <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
          <!-- Avatar -->
          <AvatarSection 
            client:load 
            nombre={personalInfo.nombre} 
            imagenUrl="/avatar.svg"
          />
          
          <!-- Info -->
          <div class="space-y-4 text-center md:text-left">
            <h1 class="text-4xl md:text-5xl font-bold tracking-tight">{personalInfo.titulo}</h1>
            <p class="text-xl text-muted-foreground max-w-2xl leading-relaxed">
              {personalInfo.sobreMi}
            </p>
            <div class="flex gap-4 justify-center md:justify-start">
              <a href="#proyectos" class="inline-flex items-center justify-center h-9 px-4 py-2 rounded-md bg-primary text-primary-foreground shadow hover:bg-primary/90 text-sm font-medium transition-all">
                Ver Proyectos
              </a>
              <a href={`mailto:${personalInfo.email}`} class="inline-flex items-center justify-center h-9 px-4 py-2 rounded-md border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground text-sm font-medium transition-all">
                Contactar
              </a>
            </div>
			<SocialLinks 
              client:load
              github={personalInfo.github}
              linkedin={personalInfo.linkedin}
              email={personalInfo.email}
              size="md"
              className="justify-center md:justify-start"
            />
          </div>
        </div>
      </section>
    </AnimateOnScroll>

    <Separator />

    <!-- Sección: Habilidades -->
    <AnimateOnScroll client:visible animation="fade-up" delay={100}>
      <section id="habilidades" class="space-y-6">
        <h2 class="text-3xl font-bold">Habilidades y Tecnologías</h2>
        <div class="flex flex-wrap gap-3">
          {habilidades.map((tech) => (
            <Badge variant="secondary" className="text-base px-4 py-2">{tech}</Badge>
          ))}
        </div>
      </section>
    </AnimateOnScroll>

    <Separator />

    <!-- Sección: Experiencia Laboral -->
    <AnimateOnScroll client:visible animation="fade-up" delay={200}>
      <section id="experiencia" class="space-y-6">
        <h2 class="text-3xl font-bold">Experiencia Laboral</h2>
        <div class="space-y-8 border-l-2 border-muted pl-6 ml-3">
          {experiencia.map((exp, index) => (
            <AnimateOnScroll client:visible animation="fade-left" delay={index * 100}>
              <div class="relative">
                <span class="absolute -left-7.75 top-1 h-4 w-4 rounded-full bg-primary ring-4 ring-background"></span>
                <span class="text-sm font-medium text-primary">{exp.periodo}</span>
                <h3 class="text-xl font-semibold mt-1">{exp.cargo}</h3>
                <p class="text-muted-foreground font-medium">{exp.empresa}</p>
                <p class="mt-2 text-sm leading-relaxed">{exp.descripcion}</p>
                {exp.logros && (
                  <ul class="mt-3 space-y-1">
                    {exp.logros.map((logro) => (
                      <li class="flex items-start text-sm text-muted-foreground">
                        <span class="mr-2 mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
                        {logro}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </AnimateOnScroll>
          ))}
        </div>
      </section>
    </AnimateOnScroll>

    <Separator />

    <!-- Sección: Educación -->
    <AnimateOnScroll client:visible animation="fade-up" delay={300}>
      <section id="educacion" class="space-y-6">
        <h2 class="text-3xl font-bold">Formación</h2>
        <div class="space-y-8 border-l-2 border-muted pl-6 ml-3">
          {educacion.map((edu, index) => (
            <AnimateOnScroll client:visible animation="fade-left" delay={index * 100}>
              <div class="relative">
                <span class="absolute -left-7.75 top-1 h-4 w-4 rounded-full bg-primary ring-4 ring-background"></span>
                <span class="text-sm font-medium text-primary">{edu.anio}</span>
                <h3 class="text-xl font-semibold mt-1">{edu.titulo}</h3>
                <p class="text-muted-foreground">{edu.institucion}</p>
                <p class="mt-2 text-sm">{edu.descripcion}</p>
              </div>
            </AnimateOnScroll>
          ))}
        </div>
      </section>
    </AnimateOnScroll>

    <Separator />

    <!-- Sección: Proyectos -->
    <AnimateOnScroll client:visible animation="fade-up" delay={400}>
      <section id="proyectos" class="space-y-6">
        <h2 class="text-3xl font-bold">Galería de Proyectos</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {proyectos.map((proyecto, index) => (
            <AnimateOnScroll client:visible animation="scale" delay={index * 150}>
              <ProjectCard client:visible project={proyecto} />
            </AnimateOnScroll>
          ))}
        </div>
      </section>
    </AnimateOnScroll>

	<Separator />

	<!-- Sección: Contacto -->

	<AnimateOnScroll client:visible animation="fade-up">
      <section id="contacto" class="space-y-6">
        <h2 class="text-3xl font-bold text-center">¿Hablamos?</h2>
        <ContactForm client:visible />
      </section>
    </AnimateOnScroll>

  </main>

    <footer class="border-t py-8 text-center text-sm text-muted-foreground">
    <div class="container mx-auto px-4 max-w-4xl space-y-4">
      <SocialLinks 
        client:load
        github={personalInfo.github}
        linkedin={personalInfo.linkedin}
        email={personalInfo.email}
        size="sm"
        className="justify-center"
      />
      <p>© {new Date().getFullYear()} {personalInfo.nombre}. Construido con Astro, React y shadcn/ui.</p>
    </div>
  </footer>
</body>
</html>